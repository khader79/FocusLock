<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/wizardDots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="● ○ ○"
        android:textSize="18sp"
        android:gravity="center"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/wizardStep1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclosure_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/wizardDisclosureText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/wizardStep2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_apps_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_apps_text"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/wizardBlockedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/wizardChooseApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_apps" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/wizardStep3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_dns_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wizard_dns_text"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/wizardOpenDns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_dns" />

        <Button
            android:id="@+id/wizardEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_protection"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/wizardBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wizard_back"
            style="?attr/materialButtonOutlinedStyle" />

        <Space
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/wizardNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2" />

    </LinearLayout>

</LinearLayout>